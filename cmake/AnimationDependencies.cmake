function(node_engine_animation_dependencies)
  if(TARGET node_animation)
    return()
  endif()
  set(ozz "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps/ozz-animation-0.17.0")
  if(NOT EXISTS "${ozz}/include/ozz/animation/runtime/skeleton.h")
    message(FATAL_ERROR "ozz-animation 0.17.0 is missing. Run tools/fetch_ozz.py first.")
  endif()
  foreach(option BUILD_SHARED_LIBS ozz_build_tools ozz_build_fbx ozz_build_gltf
      ozz_build_data ozz_build_samples ozz_build_howtos ozz_build_tests ozz_build_postfix)
    set(${option} OFF)
  endforeach()
  add_subdirectory("${ozz}" "${CMAKE_CURRENT_BINARY_DIR}/_animation/ozz" EXCLUDE_FROM_ALL)
  if(NOT TARGET fastgltf::fastgltf)
    set(FASTGLTF_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
    add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps/fastgltf-0.9.1"
      "${CMAKE_CURRENT_BINARY_DIR}/_animation/fastgltf" EXCLUDE_FROM_ALL)
  endif()
  add_library(node_animation STATIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/src/animation_asset.cpp")
  target_include_directories(node_animation PUBLIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/include"
    "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps/glm-1.0.1")
  target_link_libraries(node_animation PRIVATE ozz_animation_offline fastgltf::fastgltf)
  if(MSVC)
    target_compile_options(node_animation PRIVATE /utf-8 /W4)
  else()
    target_compile_options(node_animation PRIVATE -Wall -Wextra -Wpedantic -ffp-contract=off)
  endif()
  if(MINGW)
    target_link_options(node_animation INTERFACE -static)
  endif()
  add_custom_target(node_animation_assets
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/licenses"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${ozz}/LICENSE.md" "${CMAKE_CURRENT_BINARY_DIR}/licenses/ozz-animation.txt")
  add_dependencies(node_animation node_animation_assets)
endfunction()
