# RmlUi 6.3 focus-history access for exact checkpoint continuation. Public Focus()
# calls cannot recreate the history left by hiding the last focused document.
# No layout fields or default behavior change; see docs/rmlui-checkpoint-patch.md.
function(node_engine_patch_rmlui_checkpoint directory)
  set(header "${directory}/Include/RmlUi/Core/Context.h")
  file(SHA256 "${header}" original_hash)
  set(clean "3f3346173de4d7f611b3cf73156305c769e4bf54baab1cffbf60b9f45e5cbdb4")
  set(previous "2b39b6fb951c4c67d16b23fc957b6e55429bb1678bbace5e605fb5fffbd1a675")
  set(patched "e10f8b60a57f4db19e799cd04762ae28b3ac9eb28905f64f46c1e90618f812d0")
  if(original_hash STREQUAL patched)
    return()
  endif()
  if(NOT original_hash STREQUAL clean AND NOT original_hash STREQUAL previous)
    message(FATAL_ERROR "RmlUi Context.h changed; review the checkpoint focus-history adapter before building")
  endif()
  file(READ "${header}" source)
  set(adapter "\n\n\t// Node_Engine checkpoint adapter. The first entry is this context's root;\n\t// remaining entries must be distinct documents owned by this context.\n\tconst Vector<Element*>& GetDocumentFocusHistory() const { return document_focus_history; }\n\tvoid SetDocumentFocusHistory(const Vector<Element*>& history) { document_focus_history = history; }")
  if(original_hash STREQUAL previous)
    string(REPLACE "${adapter}" "" source "${source}")
  endif()
  string(APPEND adapter "\n\tbool ClearCheckpointFocus();")
  string(REPLACE "\tvoid UnfocusDocument(ElementDocument* document);" "\tvoid UnfocusDocument(ElementDocument* document);${adapter}" source "${source}")
  string(SHA256 updated_hash "${source}")
  if(NOT updated_hash STREQUAL patched)
    message(FATAL_ERROR "RmlUi checkpoint adapter produced unexpected bytes")
  endif()
  file(CONFIGURE OUTPUT "${header}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
endfunction()
