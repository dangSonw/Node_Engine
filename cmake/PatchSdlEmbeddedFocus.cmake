# SDL 3.4.18 must recognize keyboard focus in a native child of the Qt host.
function(node_engine_patch_sdl_embedded_focus directory)
  set(path "${directory}/src/video/windows/SDL_windowsevents.c")
  file(SHA256 "${path}" actual)
  set(clean "e18c859aec38e658f0c44a986c4ff19a5eb0ca82b6c274013ee18d5f5d602b7e")
  set(patched "e68e1280186fe436be89ffcf69ac01b8d9cb8ca738caae48d320f9c3cfd69ae4")
  if(actual STREQUAL patched)
    return()
  endif()
  if(NOT actual STREQUAL clean)
    message(FATAL_ERROR "SDL Windows focus source changed; review the embedding adapter before building")
  endif()
  file(READ "${path}" source)
  string(REPLACE "    bool has_focus = (GetForegroundWindow() == hwnd);"
    "    // Node_Engine: Qt embeds this native window under a foreign top-level HWND.\n    HWND foreground = GetForegroundWindow();\n    bool has_focus = (foreground == hwnd) ||\n        ((GetWindowLongPtr(hwnd, GWL_STYLE) & WS_CHILD) && GetFocus() == hwnd &&\n         GetAncestor(hwnd, GA_ROOT) == foreground);" source "${source}")
  string(SHA256 updated "${source}")
  if(NOT updated STREQUAL patched)
    message(FATAL_ERROR "SDL focus adapter produced unexpected bytes")
  endif()
  file(CONFIGURE OUTPUT "${path}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
endfunction()
