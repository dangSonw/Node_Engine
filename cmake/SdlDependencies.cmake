function(node_engine_sdl_dependency)
  if(TARGET SDL3::SDL3)
    return()
  endif()
  if(NOT WIN32)
    find_package(SDL3 CONFIG REQUIRED)
    return()
  endif()
  set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps/SDL3-source-3.4.18/SDL3-3.4.18")
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/PatchSdlEmbeddedFocus.cmake")
  node_engine_patch_sdl_embedded_focus("${source}")
  set(SDL_SHARED ON CACHE BOOL "" FORCE)
  set(SDL_STATIC OFF CACHE BOOL "" FORCE)
  set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
  set(SDL_TESTS OFF CACHE BOOL "" FORCE)
  set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
  add_subdirectory("${source}" "${CMAKE_CURRENT_BINARY_DIR}/_sdl" EXCLUDE_FROM_ALL)
endfunction()
