# Pinned sources and license provenance live alongside each dependency.
function(node_engine_ui_dependencies)
  if(TARGET node_ui_sdl_backend)
    return()
  endif()
  get_filename_component(deps "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../deps" ABSOLUTE)
  set(BUILD_SHARED_LIBS OFF)
  set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
  set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
  set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
  set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
  set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
  add_subdirectory("${deps}/freetype-2.15.0" "${CMAKE_CURRENT_BINARY_DIR}/_ui/freetype" EXCLUDE_FROM_ALL)
  if(NOT TARGET Freetype::Freetype)
    add_library(Freetype::Freetype ALIAS freetype)
  endif()
  set(CMAKE_DISABLE_FIND_PACKAGE_Freetype TRUE)
  set(RMLUI_SAMPLES OFF CACHE BOOL "" FORCE)
  set(RMLUI_LUA_BINDINGS OFF CACHE BOOL "" FORCE)
  set(RMLUI_FONT_ENGINE freetype CACHE STRING "" FORCE)
  set(RMLUI_PRECOMPILED_HEADERS ON CACHE BOOL "" FORCE)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/PatchRmlUiCheckpoint.cmake")
  node_engine_patch_rmlui_checkpoint("${deps}/RmlUi-6.3")
  add_subdirectory("${deps}/RmlUi-6.3" "${CMAKE_CURRENT_BINARY_DIR}/_ui/rmlui" EXCLUDE_FROM_ALL)
  # The upstream backend assumes that its target is the window swapchain. UI
  # colors are sRGB bytes, so render them into a UNORM intermediate before
  # compositing into the engine's linear scene. Keep the pinned source intact.
  set(backend "${CMAKE_CURRENT_BINARY_DIR}/_ui/backend")
  file(MAKE_DIRECTORY "${backend}")
  file(READ "${deps}/RmlUi-6.3/Backends/RmlUi_Renderer_SDL_GPU.h" header)
  file(READ "${deps}/RmlUi-6.3/Backends/RmlUi_Renderer_SDL_GPU.cpp" source)
  file(SHA256 "${deps}/RmlUi-6.3/Backends/RmlUi_Renderer_SDL_GPU.h" header_hash)
  file(SHA256 "${deps}/RmlUi-6.3/Backends/RmlUi_Renderer_SDL_GPU.cpp" source_hash)
  if(NOT header_hash STREQUAL "726419714fbed50c8211f9cbd5d1c570ce5b365b608cc25ddb3f5544b359ebc3" OR
     NOT source_hash STREQUAL "3e9bb95d30cdc95e0b431a629a7dd8288853d2842e3218874faab1f26ecbc66a")
    message(FATAL_ERROR "RmlUi SDL GPU backend changed; review its target-format adapter before building")
  endif()
  string(REPLACE "SDL_Window* window);" "SDL_Window* window, SDL_GPUTextureFormat target_format = SDL_GPU_TEXTUREFORMAT_INVALID);" header "${header}")
  string(REPLACE "SDL_Window* window;" "SDL_Window* window;\n\tSDL_GPUTextureFormat target_format;" header "${header}")
  string(REPLACE "target.format = SDL_GetGPUSwapchainTextureFormat(device, window);" "target.format = target_format;" source "${source}")
  string(REPLACE "SDL_Window* window) :" "SDL_Window* window, SDL_GPUTextureFormat format) :" source "${source}")
  string(REPLACE "device(device), window(window)," "device(device), window(window), target_format(format == SDL_GPU_TEXTUREFORMAT_INVALID ? SDL_GetGPUSwapchainTextureFormat(device, window) : format)," source "${source}")
  file(CONFIGURE OUTPUT "${backend}/RmlUi_Renderer_SDL_GPU.h" CONTENT "${header}" @ONLY)
  file(CONFIGURE OUTPUT "${backend}/RmlUi_Renderer_SDL_GPU.cpp" CONTENT "${source}" @ONLY)
  add_library(node_ui_sdl_backend STATIC
    "${backend}/RmlUi_Renderer_SDL_GPU.cpp"
    "${deps}/RmlUi-6.3/Backends/RmlUi_Platform_SDL.cpp")
  target_include_directories(node_ui_sdl_backend PUBLIC "${backend}" "${deps}/RmlUi-6.3/Backends")
  target_compile_definitions(node_ui_sdl_backend PUBLIC RMLUI_SDL_VERSION_MAJOR=3)
  target_link_libraries(node_ui_sdl_backend PUBLIC RmlUi::Core SDL3::SDL3 SDL3_image::SDL3_image-shared)
  add_library(node_ui_renderer STATIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/src/ui_renderer.cpp")
  target_include_directories(node_ui_renderer PUBLIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/include")
  target_link_libraries(node_ui_renderer PUBLIC node_ui_sdl_backend)
  add_library(node_ui_session STATIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/src/ui_session.cpp")
  target_include_directories(node_ui_session PUBLIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/include" "${deps}/include")
  target_link_libraries(node_ui_session PUBLIC node_ui_sdl_backend)
endfunction()
